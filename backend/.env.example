# Sao chép thành .env và thay các giá trị mẫu trước khi chạy.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/pet_heartbeat_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# Phải giống JWT_SECRET trong backend-nodejs/.env (ít nhất 32 ký tự).
JWT_SECRET=replace-with-the-same-random-secret-as-spring-boot
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

REDIS_HOST=replace-with-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=change-me

BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=sender@example.com

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

GEMINI_API_KEY=replace-with-gemini-api-key
