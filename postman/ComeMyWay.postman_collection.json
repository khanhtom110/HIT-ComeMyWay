        {
          "name": "07 Chi tiết bài công khai có ảnh",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{nodeBaseUrl}}/api/v1/public/clinic-posts/{{createdPostId}}",
            "description": "Trả nội dung và toàn bộ URL ảnh đúng thứ tự."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 và đủ ảnh', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const post = pm.response.json().data;",
                  "  pm.expect(String(post.id)).to.eql(String(pm.environment.get('createdPostId')));",
                  "  pm.expect(post.imageUrls).to.deep.eql(JSON.parse(pm.variables.get('postImageUrls')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Xóa bài đăng của mình",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{nodeBaseUrl}}/api/v1/clinic/posts/{{createdPostId}}",
            "description": "Xóa bài vừa tạo bằng access token của phòng khám."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Deleted post matches created post\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(String(body.data.id)).to.eql(String(pm.environment.get(\"createdPostId\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Bài đã xóa không còn công khai",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{nodeBaseUrl}}/api/v1/public/clinic-posts",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
