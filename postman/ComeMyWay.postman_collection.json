{
  "info": {
    "_postman_id": "9cc39b8b-58a1-42d7-9628-75218b1c588f",
    "name": "ComeMyWay - Spring Boot + Node.js",
    "description": "Test luồng phòng khám: đăng nhập Spring Boot → dùng JWT đăng tin Node.js → kiểm tra quyền và validation. Xem postman/README.md. Chọn environment trước khi chạy. Với Dev Fake chỉ chạy các folder Node; với Local chạy cả collection. Mỗi lượt chạy tạo một bài đăng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "postTitle",
      "value": "Thông báo lịch khám",
      "type": "string"
    },
    {
      "key": "postContent",
      "value": "Phòng khám nhận lịch khám cho thú cưng. Vui lòng liên hệ để đặt lịch.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Spring Boot",
      "item": [
        {
          "name": "01 Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{springBaseUrl}}/api/v1/public/health",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Spring Boot is awake\", () => pm.expect(pm.response.json().data).to.eql(\"Server is awake\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login clinic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{springBaseUrl}}/api/v1/auth/login",
            "description": "Nhập username/password của tài khoản phòng khám ACTIVE trong environment. Tự lưu accessToken và refreshToken.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{loginBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"accessToken\");",
                  "pm.environment.unset(\"refreshToken\");",
                  "pm.environment.unset(\"clinicId\");",
                  "pm.environment.unset(\"createdPostId\");",
                  "pm.variables.set(\"loginBody\", JSON.stringify({",
                  "  username: pm.environment.get(\"username\") || \"\",",
                  "  password: pm.environment.get(\"password\") || \"\"",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Active clinic account and token pair\", () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.role).to.eql(\"CLINIC\");",
                  "  pm.expect(data.accountStatus).to.eql(\"ACTIVE\");",
                  "  pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(data.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  if (data.role === \"CLINIC\" && data.accountStatus === \"ACTIVE\") {",
                  "    pm.environment.set(\"accessToken\", data.accessToken);",
                  "    pm.environment.set(\"refreshToken\", data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{springBaseUrl}}/api/v1/auth/refresh",
            "description": "Dùng refreshToken từ request đăng nhập; tự thay accessToken/refreshToken bằng cặp mới.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{refreshBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"refreshBody\", JSON.stringify({refreshToken: pm.environment.get(\"refreshToken\") || \"\"}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Active clinic account and token pair\", () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.role).to.eql(\"CLINIC\");",
                  "  pm.expect(data.accountStatus).to.eql(\"ACTIVE\");",
                  "  pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(data.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  if (data.role === \"CLINIC\" && data.accountStatus === \"ACTIVE\") {",
                  "    pm.environment.set(\"accessToken\", data.accessToken);",
                  "    pm.environment.set(\"refreshToken\", data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Clinic profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{springBaseUrl}}/api/v1/clinic/profile",
