        {
          "name": "03 Danh sách bài công khai",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{nodeBaseUrl}}/api/v1/public/clinic-posts",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"At most 50 posts, newest first\", () => {",
                  "  const posts = pm.response.json().data;",
                  "  pm.expect(posts).to.be.an(\"array\");",
                  "  pm.expect(posts.length).to.be.at.most(50);",
                  "  posts.forEach((post, index) => {",
                  "    pm.expect(post).to.include.all.keys(\"id\", \"clinicId\", \"clinicName\", \"title\", \"content\", \"createdAt\");",
                  "    if (index > 0) pm.expect(Number(posts[index - 1].id)).to.be.at.least(Number(post.id));",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Tạo bài đăng có ảnh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{nodeBaseUrl}}/api/v1/clinic/posts",
            "description": "Tạo bài kèm tối đa 10 URL ảnh HTTP(S); imageUrls là tùy chọn.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{postTitle}}\",\n  \"content\": \"{{postContent}}\",\n  \"imageUrls\": {{postImageUrls}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"createdPostId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(201);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Post fields match submitted data\", () => {",
                  "  const post = pm.response.json().data;",
                  "  pm.expect(Number(post.id)).to.be.above(0);",
                  "  pm.expect(post.title).to.eql(pm.variables.get(\"postTitle\").trim());",
                  "  pm.expect(post.content).to.eql(pm.variables.get(\"postContent\").trim());",
                  "  pm.expect(post.imageUrls).to.deep.eql(JSON.parse(pm.variables.get(\"postImageUrls\")));",
                  "  pm.expect(post.clinicName).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(Number.isNaN(Date.parse(post.createdAt))).to.eql(false);",
                  "});",
                  "pm.test(\"Author ID is valid and matches profile when available\", () => {",
                  "  const clinicId = pm.environment.get(\"clinicId\");",
                  "  const postClinicId = pm.response.json().data.clinicId;",
                  "  pm.expect(Number(postClinicId)).to.be.above(0);",
                  "  if (clinicId) pm.expect(String(postClinicId)).to.eql(String(clinicId));",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const post = pm.response.json().data;",
                  "  if (!pm.environment.get(\"clinicId\")) pm.environment.set(\"clinicId\", post.clinicId);",
                  "  pm.environment.set(\"createdPostId\", post.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Bài đăng của phòng khám",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{nodeBaseUrl}}/api/v1/clinic/posts",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"At most 50 posts, newest first\", () => {",
                  "  const posts = pm.response.json().data;",
                  "  pm.expect(posts).to.be.an(\"array\");",
                  "  pm.expect(posts.length).to.be.at.most(50);",
                  "  posts.forEach((post, index) => {",
                  "    pm.expect(post).to.include.all.keys(\"id\", \"clinicId\", \"clinicName\", \"title\", \"content\", \"createdAt\");",
                  "    if (index > 0) pm.expect(Number(posts[index - 1].id)).to.be.at.least(Number(post.id));",
                  "  });",
                  "});",
                  "pm.test(\"Contains the post just created\", () => {",
                  "  const id = pm.environment.get(\"createdPostId\");",
                  "  pm.expect(id, \"Run Create post first\").to.be.ok;",
                  "  pm.expect(pm.response.json().data.some(post => String(post.id) === String(id))).to.eql(true);",
                  "});",
                  "pm.test(\"Only the signed-in clinic's posts\", () => {",
                  "  const clinicId = pm.environment.get(\"clinicId\");",
                  "  pm.response.json().data.forEach(post => pm.expect(String(post.clinicId)).to.eql(String(clinicId)));",
                  "});"
                ]
              }
            }
          ]
        },
