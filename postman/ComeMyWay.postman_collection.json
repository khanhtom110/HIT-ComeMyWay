        {
          "name": "03 Tiêu đề vượt 200 ký tự",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{nodeBaseUrl}}/api/v1/clinic/posts",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{{invalidBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"invalidBody\", JSON.stringify({title: \"x\".repeat(201), content: \"Test\"}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
