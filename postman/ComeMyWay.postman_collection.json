            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(200);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"At most 50 posts, newest first\", () => {",
                  "  const posts = pm.response.json().data;",
                  "  pm.expect(posts).to.be.an(\"array\");",
                  "  pm.expect(posts.length).to.be.at.most(50);",
                  "  posts.forEach((post, index) => {",
                  "    pm.expect(post).to.include.all.keys(\"id\", \"clinicId\", \"clinicName\", \"title\", \"content\", \"createdAt\");",
                  "    if (index > 0) pm.expect(Number(posts[index - 1].id)).to.be.at.least(Number(post.id));",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{nodeBaseUrl}}/api/v1/clinic/posts",
            "description": "Mỗi lần chạy tạo một bài thật trong môi trường được chọn. clinicId=-1 kiểm tra server luôn lấy tác giả từ token.",
            "body": {
              "mode": "raw",
              "raw": "{{postBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"createdPostId\");",
                  "pm.variables.set(\"postBody\", JSON.stringify({",
                  "  title: pm.variables.get(\"postTitle\"),",
                  "  content: pm.variables.get(\"postContent\"),",
                  "  clinicId: -1",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(201);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Post fields match submitted data\", () => {",
                  "  const post = pm.response.json().data;",
                  "  pm.expect(Number(post.id)).to.be.above(0);",
                  "  pm.expect(post.title).to.eql(pm.variables.get(\"postTitle\").trim());",
                  "  pm.expect(post.content).to.eql(pm.variables.get(\"postContent\").trim());",
                  "  pm.expect(post.clinicName).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(Number.isNaN(Date.parse(post.createdAt))).to.eql(false);",
                  "});",
                  "pm.test(\"Author comes from the token, ignores supplied clinicId\", () => {",
                  "  const clinicId = pm.environment.get(\"clinicId\");",
                  "  pm.expect(clinicId, \"Run Spring Clinic profile or use the dev environment\").to.be.ok;",
                  "  pm.expect(String(pm.response.json().data.clinicId)).to.eql(String(clinicId));",
                  "  pm.expect(Number(pm.response.json().data.clinicId)).not.to.eql(-1);",
                  "});",
                  "if (pm.response.code === 201) pm.environment.set(\"createdPostId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
