    {
      "name": "03 - Node Validation",
      "item": [
        {
          "name": "01 Blank title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{nodeBaseUrl}}/api/v1/clinic/posts",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \",\n  \"content\": \"Nội dung kiểm thử\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Response envelope\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(400);",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Error message without internal details\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.eql(null);",
                  "  pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body).not.to.have.property(\"stack\");",
                  "});"
                ]
              }
            }
          ]
