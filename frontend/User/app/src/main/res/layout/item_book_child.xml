<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="@color/colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/image_click"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:background="@drawable/ground_book_child">

        <ImageView
            android:id="@+id/image"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/image_test"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginStart="@dimen/_15sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            style="@style/Nut1"
            android:id="@+id/nameRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phòng khám thú y Hà Nội Funpet"
            android:layout_marginStart="@dimen/_60sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:textColor="@color/colorTextSub"
            app:layout_constraintTop_toTopOf="@id/image"
            app:layout_constraintBottom_toBottomOf="@id/image"
            app:layout_constraintStart_toEndOf="@id/image"/>

        <ImageView
            android:id="@+id/image_locate"
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/locate"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_16sdp"
            app:layout_constraintTop_toBottomOf="@id/image"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            style="@style/Chu2"
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="83 Giải Phóng, P. Đồng Tâm"
            android:textColor="@color/colorTextSub"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/image"
            app:layout_constraintStart_toEndOf="@id/image_locate"/>

        <ImageView
            android:id="@+id/image_time"
            android:layout_width="@dimen/_11sdp"
            android:layout_height="@dimen/_11sdp"
            android:src="@drawable/time"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_15sdp"
            app:layout_constraintTop_toBottomOf="@id/address"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            style="@style/Chu2"
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25/06/06 -"
            android:textColor="@color/colorTextSub"
            android:layout_marginStart="@dimen/_4sdp"
            app:layout_constraintTop_toTopOf="@id/image_time"
            app:layout_constraintBottom_toBottomOf="@id/image_time"
            app:layout_constraintStart_toEndOf="@id/image_time"/>

        <TextView
            style="@style/Chu2"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:00"
            android:textColor="@color/colorTextSub"
            android:layout_marginStart="@dimen/_4sdp"
            app:layout_constraintTop_toTopOf="@id/date"
            app:layout_constraintBottom_toBottomOf="@id/date"
            app:layout_constraintStart_toEndOf="@id/date"/>

        <TextView
            android:id="@+id/status_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_28sdp"
            android:background="@drawable/button_input"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@id/time"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/test"
            android:layout_width="@dimen/_82sdp"
            android:layout_height="@dimen/_26sdp"
            android:src="@drawable/secondary_input_book"
            app:layout_constraintTop_toTopOf="@id/status_button"
            android:layout_marginStart="@dimen/_14sdp"
            app:layout_constraintBottom_toBottomOf="@id/status_button"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            style="@style/TieuDe2"
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chờ xử lý"
            android:textColor="@color/colorWarning"
            app:layout_constraintTop_toTopOf="@id/status_button"
            app:layout_constraintBottom_toBottomOf="@id/status_button"
            app:layout_constraintStart_toEndOf="@id/test"
            app:layout_constraintEnd_toEndOf="@id/status_button"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>