<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorBackground"
    tools:context="com.vetpet.petbeats.ui.home_user.editpassword_setting.EditPasswordSettingFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginStart="16dp"
            android:src="@drawable/back_left"
            android:layout_marginTop="@dimen/_40sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            style="@style/TieuDe1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thay đổi mật khẩu"
            android:textColor="@color/colorTextSub"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/boxInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ground_information"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginVertical="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <TextView
                style="@style/Chu2"
                android:id="@+id/textPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu hiện tại"
                android:textColor="@color/colorTextSub"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                style="@style/Chu1"
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/button_input"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:textColor="@color/colorTextTitle"
                android:textColorHint="@color/colorTextHint"
                android:inputType="textPassword"
                android:hint="Nhập mật khẩu hiện tại"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/textPassword"/>

            <ImageView
                android:id="@+id/eye"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_8sdp"
                android:src="@drawable/close_eye"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="@id/inputPassword"
                app:layout_constraintTop_toTopOf="@id/inputPassword"
                app:layout_constraintBottom_toBottomOf="@id/inputPassword"/>

            <TextView
                style="@style/Chu3"
                android:id="@+id/passwordError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text=""
                android:textColor="@color/colorError"
                android:visibility="gone"
                android:drawablePadding="2dp"
                app:drawableStartCompat="@drawable/warning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inputPassword" />

            <TextView
                style="@style/Chu3"
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu?"
                android:textColor="@color/colorPrimary"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/passwordError"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                style="@style/Chu2"
                android:id="@+id/textNewPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu mới"
                android:textColor="@color/colorTextContent"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/btnForgotPassword"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                style="@style/Chu1"
                android:id="@+id/textNewInputPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/tittle_search"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:textColor="@color/colorTextTitle"
                android:textColorHint="@color/colorTextHint"
                android:inputType="textPassword"
                android:hint="Mật khẩu phải có 8 kí tự trở lên"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/textNewPassword"/>

            <ImageView
                android:id="@+id/eye"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_8sdp"
                android:src="@drawable/close_eye"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="@id/textNewInputPassword"
                app:layout_constraintTop_toTopOf="@id/textNewInputPassword"
                app:layout_constraintBottom_toBottomOf="@id/textNewInputPassword"/>

            <TextView
                style="@style/Chu3"
                android:id="@+id/passwordNewError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text=""
                android:textColor="@color/colorError"
                android:visibility="gone"
                android:drawablePadding="2dp"
                app:drawableStartCompat="@drawable/warning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textNewInputPassword" />

            <TextView
                style="@style/Chu2"
                android:id="@+id/textNewPassword1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập lại mật khẩu"
                android:textColor="@color/colorTextContent"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/passwordNewError"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                style="@style/Chu1"
                android:id="@+id/textNewInputPassword1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:background="@drawable/tittle_search"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:textColor="@color/colorTextTitle"
                android:textColorHint="@color/colorTextHint"
                android:inputType="textPassword"
                android:hint="Nhập mật khẩu"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/textNewPassword1"/>

            <ImageView
                android:id="@+id/eye1"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_8sdp"
                android:src="@drawable/close_eye"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="@id/textNewInputPassword1"
                app:layout_constraintTop_toTopOf="@id/textNewInputPassword1"
                app:layout_constraintBottom_toBottomOf="@id/textNewInputPassword1"/>

            <TextView
                style="@style/Chu3"
                android:id="@+id/passwordNewError1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text=""
                android:textColor="@color/colorError"
                android:visibility="gone"
                android:drawablePadding="2dp"
                app:drawableStartCompat="@drawable/warning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textNewInputPassword1" />



        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/btnUpdate"
            style="@style/Nut2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_auth_blue"
            android:gravity="center"
            android:text="Cập nhật"
            android:textColor="@color/colorBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/boxInformation" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>