<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.vetpet.petbeats.ui.home_clinic.appointmentschedule.AppointmentScheduleFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TieuDe"
                android:id="@+id/tvIntroduce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xin chào, "
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                style="@style/TieuDe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="phòng khám thú y FunPet"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_14sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@id/tvIntroduce"
                app:layout_constraintStart_toStartOf="parent"/>
            
            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:src="@drawable/logo1"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxAppointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ground_book_child"
                android:layout_marginTop="@dimen/_35sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:paddingBottom="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@id/tvIntroduce">

                <TextView
                    style="@style/Nut1"
                    android:id="@+id/tittle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch hẹn của phòng khám"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="@dimen/_4sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_120sdp"
                    android:background="@drawable/ground_schedule"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintTop_toBottomOf="@+id/tittle">

                    <TextView
                        style="@style/Chu3"
                        android:id="@+id/tvScheduleToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lịch khám hôm nay"
                        android:layout_marginTop="@dimen/_32sdp"
                        android:layout_marginStart="@dimen/_16sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TieuDe2"
                        android:id="@+id/numbScheduleToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintTop_toTopOf="@id/tvScheduleToday"
                        app:layout_constraintBottom_toBottomOf="@id/tvScheduleToday"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        style="@style/Chu3"
                        android:id="@+id/tvWait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chờ xét duyệt"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginStart="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@id/tvScheduleToday"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TieuDe2"
                        android:id="@+id/numbWait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintTop_toTopOf="@id/tvWait"
                        app:layout_constraintBottom_toBottomOf="tvWait"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        style="@style/Chu3"
                        android:id="@+id/tvReceive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiếp nhận"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginStart="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@id/tvWait"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TieuDe2"
                        android:id="@+id/numbReceive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintTop_toTopOf="@id/tvReceive"
                        app:layout_constraintBottom_toBottomOf="tvReceive"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        style="@style/Chu3"
                        android:id="@+id/tvRefuse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Từ chối"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:layout_marginStart="@dimen/_16sdp"
                        app:layout_constraintTop_toBottomOf="@id/tvReceive"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        style="@style/TieuDe2"
                        android:id="@+id/numbRefuse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:layout_constraintTop_toTopOf="@id/tvRefuse"
                        app:layout_constraintBottom_toBottomOf="tvRefuse"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/tvSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch khám hôm nay"
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_35sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@id/boxAppointment"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/buttonAll"
                android:layout_width="@dimen/_49sdp"
                android:layout_height="@dimen/_25sdp"
                android:background="@drawable/button_all"
                android:text="Tất cả"
                android:gravity="center"
                android:textColor="@color/colorTextButtonHome"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="@id/tvSchedule"
                app:layout_constraintBottom_toBottomOf="@id/tvSchedule"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/btnBackLeft"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="16dp"
                android:src="@drawable/back_left"
                android:layout_marginTop="@dimen/_40sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/viewpager"/>

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/viewpager"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_126sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:layout_marginHorizontal="@dimen/_50sdp"
                app:layout_constraintTop_toBottomOf="@id/tvSchedule"/>

            <ImageView
                android:id="@+id/btnBackRight"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/back_right"
                android:layout_marginTop="@dimen/_45sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/viewpager"/>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/tvListSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch khám hôm nay"
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_35sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@id/viewpager"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/buttonListAll"
                android:layout_width="@dimen/_49sdp"
                android:layout_height="@dimen/_25sdp"
                android:background="@drawable/button_all"
                android:text="Tất cả"
                android:gravity="center"
                android:textColor="@color/colorTextButtonHome"
                android:layout_marginEnd="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="@id/tvListSchedule"
                app:layout_constraintBottom_toBottomOf="@id/tvListSchedule"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ground_information"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginVertical="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/tvListSchedule">

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/btnWait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chờ xử lý"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_24sdp"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/btnReceive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiếp nhận"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnWait"
                    app:layout_constraintEnd_toStartOf="@id/btnRefuse"/>

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/btnRefuse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Từ chối"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_24sdp"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:id="@+id/line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:src="@drawable/line"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    app:layout_constraintTop_toBottomOf="@id/btnWait"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    app:layout_constraintTop_toBottomOf="@id/line"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</FrameLayout>