<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorBackground"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ground_book_child"
        android:layout_marginHorizontal="@dimen/_2sdp"
        android:layout_marginVertical="@dimen/_2sdp"
        android:paddingBottom="@dimen/_16sdp">

        <View
            android:id="@+id/shimmerImgPet"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginStart="@dimen/_16sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/shimmerTypePet"
            android:layout_width="180dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintTop_toTopOf="@id/shimmerImgPet"
            app:layout_constraintBottom_toBottomOf="@id/shimmerImgPet"
            app:layout_constraintStart_toEndOf="@id/shimmerImgPet"/>

        <View
            android:id="@+id/shimmerUser"
            android:layout_width="220dp"
            android:layout_height="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/_12sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerImgPet"/>

        <View
            android:id="@+id/shimmerClinic"
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="@dimen/_12sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerUser"/>

        <View
            android:id="@+id/shimmerTime"
            android:layout_width="150dp"
            android:layout_height="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="@dimen/_12sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerClinic"/>

        <View
            android:id="@+id/shimmerDetail"
            android:layout_width="80dp"
            android:layout_height="14dp"
            android:layout_marginTop="12dp"
            android:background="@color/colorShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerTime"/>

        <View
            android:id="@+id/shimmerBtnRefuse"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintTop_toBottomOf="@id/shimmerDetail"
            app:layout_constraintStart_toStartOf="parent"/>

        <View
            android:id="@+id/shimmerBtnReceive"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:background="@color/colorShimmer"
            app:layout_constraintTop_toBottomOf="@id/shimmerDetail"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>