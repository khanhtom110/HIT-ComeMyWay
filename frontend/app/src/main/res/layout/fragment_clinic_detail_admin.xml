<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorBackground"
    tools:context="com.vetpet.petbeats.ui.home_admin.clinic_detail_admin.ClinicDetailAdminFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_16sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="16dp"
                android:src="@drawable/back_left"
                android:layout_marginTop="@dimen/_40sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/TieuDe1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch khám hôm nay"
                android:textColor="@color/colorTextSub"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/imgClinic"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:src="@drawable/image_test"
                android:layout_marginTop="@dimen/_16sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack"/>

            <TextView
                style="@style/Nut1"
                android:id="@+id/nameClinic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phòng khám thú y FunVet"
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                app:layout_constraintTop_toBottomOf="@id/imgClinic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/tvDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết"
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@id/nameClinic"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ground_information"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginVertical="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/tvDetail">

                <TextView
                    style="@style/Chu3"
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số điện thoại"
                    android:textColor="@color/colorTextSub"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/textPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="01/08/2026"
                    android:layout_marginStart="@dimen/_130sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:textColor="@color/colorTextSub"
                    app:layout_constraintTop_toTopOf="@id/tvPhone"
                    app:layout_constraintBottom_toBottomOf="@id/tvPhone"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/Chu3"
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Địa chỉ"
                    android:textColor="@color/colorTextSub"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    app:layout_constraintTop_toBottomOf="@id/textPhone"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/textAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="83 Giải Phóng, P. Đồng Tâm"
                    android:layout_marginStart="@dimen/_130sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:textColor="@color/colorTextSub"
                    app:layout_constraintTop_toTopOf="@id/tvAddress"
                    app:layout_constraintBottom_toBottomOf="@id/tvAddress"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/Chu3"
                    android:id="@+id/tvMap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Địa chỉ liên kết"
                    android:textColor="@color/colorTextSub"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    app:layout_constraintTop_toBottomOf="@id/textAddress"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/textMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="https://maps.app.goo.gl/DKeM55fRLLhhUCBn9"
                    android:layout_marginStart="@dimen/_130sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="@id/tvMap"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    style="@style/Chu3"
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giờ hoạt động"
                    android:textColor="@color/colorTextSub"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_16sdp"
                    app:layout_constraintTop_toBottomOf="@id/textMap"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/openTime"
                    style="@style/TieuDe2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorTextSub"
                    tools:text="07:00"
                    android:layout_marginEnd="@dimen/_5sdp"
                    app:layout_constraintBottom_toBottomOf="@id/closeTime"
                    app:layout_constraintEnd_toStartOf="@id/center"
                    app:layout_constraintTop_toTopOf="@id/tvTime" />

                <TextView
                    style="@style/Chu1"
                    android:id="@+id/center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@color/colorTextSub"
                    android:layout_marginEnd="@dimen/_5sdp"
                    app:layout_constraintTop_toTopOf="@id/closeTime"
                    app:layout_constraintBottom_toBottomOf="@id/closeTime"
                    app:layout_constraintEnd_toStartOf="@id/closeTime"/>

                <TextView
                    style="@style/TieuDe2"
                    android:id="@+id/closeTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="24:00"
                    android:layout_marginEnd="@dimen/_83sdp"
                    android:textColor="@color/colorTextSub"
                    app:layout_constraintTop_toTopOf="@id/tvTime"
                    app:layout_constraintEnd_toEndOf="parent"/>



            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/tvInformation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô tả"
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@id/boxDetail"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ground_information"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:paddingBottom="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/tvInformation">

                <TextView
                    style="@style/Chu3"
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Với tầm"
                    android:textColor="@color/colorTextContent"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    app:layout_constraintTop_toTopOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/TieuDe1"
                android:id="@+id/tvService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loại dịch vụ"
                android:textColor="@color/colorTextSub"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@id/boxInformation"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ground_information"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginVertical="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                app:layout_constraintTop_toBottomOf="@id/tvService">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/boxReason" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</FrameLayout>