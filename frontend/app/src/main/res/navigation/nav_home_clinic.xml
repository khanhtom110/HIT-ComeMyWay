<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_home_clinic"
    app:startDestination="@id/appointmentScheduleFragment">

    <fragment
        android:id="@+id/appointmentScheduleFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.appointmentschedule.AppointmentScheduleFragment"
        android:label="appointmentScheduleFragment"/>

    <fragment
        android:id="@+id/clinicFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.clinic.ClinicFragment"
        android:label="clinicFragment"/>

    <fragment
        android:id="@+id/scheduleListFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.schedulelist.ScheduleListFragment"
        android:label="scheduleListFragment">
        <action
            android:id="@+id/scheduleList_appointmentSchedule"
            app:destination="@id/appointmentScheduleFragment"
            app:popUpTo="@id/appointmentScheduleFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/appointmentDetailWaitFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.appointmentdetail_wait.AppointmentDetailWaitFragment"
        android:label="appointmentDetailWait">
        <action
            android:id="@+id/wait_appointmentSchedule"
            app:destination="@id/appointmentScheduleFragment"
            app:popUpTo="@id/appointmentScheduleFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/appointmentDetailReceiveFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.appointmentdetail_receive.AppointmentDetailReceiveFragment"
        android:label="appointmentDetailReceive">
        <action
            android:id="@+id/receive_appointmentSchedule"
            app:destination="@id/appointmentScheduleFragment"
            app:popUpTo="@id/appointmentScheduleFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/appointmentDetailRefuseFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.appointmentdetai_refuse.AppointmentDetailRefuseFragment"
        android:label="appointmentDetailRefuse">
        <action
            android:id="@+id/refuse_appointmentSchedule"
            app:destination="@id/appointmentScheduleFragment"
            app:popUpTo="@id/appointmentScheduleFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/editInformationClinicFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.edit_information_clinic.EditInformationClinicFragment"
        android:label="editInformationClinicFragment">
        <action
            android:id="@+id/editInformation_clinic"
            app:destination="@id/clinicFragment"
            app:popUpTo="@id/clinicFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/editPasswordClinicFragment"
        android:name="com.vetpet.petbeats.ui.home_clinic.edit_password_clinic.EditPasswordClinicFragment"
        android:label="editPasswordClinicFragment">
        <action
            android:id="@+id/editPassword_clinic"
            app:destination="@id/clinicFragment"
            app:popUpTo="@id/clinicFragment"
            app:popUpToInclusive="true"/>
    </fragment>

</navigation>