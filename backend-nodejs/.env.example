# Use the same JWT_SECRET and database as the Spring Boot backend.
# JWT_SECRET must have at least 32 characters.
NODE_ENV=development
JWT_SECRET=
HOST=127.0.0.1
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_heartbeat_db
DB_USERNAME=root
DB_PASSWORD=
# Comma-separated browser origins. Native Android requests need no origin.
CORS_ORIGINS=http://localhost:3000
